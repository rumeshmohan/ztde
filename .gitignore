# Track only the bootcamp folders, submissions/, this file and the README.
# Everything else at the top level (course-repos/, ...) stays local.
/*
!/.gitignore
!/README.md
!/bootcamp-*/
!/submissions/

# Bootcamp 02: only the folder itself is tracked, its contents stay local
/bootcamp-02-big-data-pipelines/*
!/bootcamp-02-big-data-pipelines/.gitkeep

# Submissions: only the per-bootcamp folders are tracked, the zips stay local
/submissions/*
!/submissions/*/
/submissions/*/*
!/submissions/*/.gitkeep

# Personal course submission form
ZuuCrew-Project-Submission-Form.docx

# Secrets and local environments
.env
.venv/
venv/

# Runtime output and caches
logs/
__pycache__/
*.pyc

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
