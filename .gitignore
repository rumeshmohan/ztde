# Track only the bootcamp folders, submissions/, this file and the README.
# Everything else at the top level (course-repos/, ...) stays local.
/*
!/.gitignore
!/README.md
!/bootcamp-*/
!/submissions/

# Bootcamp 02: kept local for now
/bootcamp-02-big-data-pipelines/*

# Submissions: one folder per bootcamp holding the submitted zips
/submissions/*
!/submissions/*/

# Personal course submission form
ZuuCrew-Project-Submission-Form.docx

# Secrets and local environments
.env
.venv/
venv/

# Runtime output and caches
logs/
__pycache__/
*.pyc

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
