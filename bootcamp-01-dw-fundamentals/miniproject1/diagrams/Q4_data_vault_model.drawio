<mxfile host="app.diagrams.net">
  <diagram name="Q4 Data Vault Model" id="q4diagram">
    <mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Column headers -->
        <mxCell id="hdr_hubs" value="HUBS (Business Keys)" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hdr_links" value="LINKS (Relationships)" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sats" value="SATELLITES (Context)" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="800" y="20" width="240" height="30" as="geometry" />
        </mxCell>

        <!-- HUBS -->
        <mxCell id="hub_customer" value="&lt;b&gt;HUB_CUSTOMER&lt;/b&gt;&lt;br&gt;customer_hash_key (PK)&lt;br&gt;load_date&lt;br&gt;record_source&lt;br&gt;customer_no (Business Key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="hub_content" value="&lt;b&gt;HUB_CONTENT&lt;/b&gt;&lt;br&gt;content_hash_key (PK)&lt;br&gt;load_date&lt;br&gt;record_source&lt;br&gt;content_id (Business Key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="hub_inventory" value="&lt;b&gt;HUB_INVENTORY&lt;/b&gt;&lt;br&gt;inventory_hash_key (PK)&lt;br&gt;load_date&lt;br&gt;record_source&lt;br&gt;barcode (Business Key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="hub_subscription" value="&lt;b&gt;HUB_SUBSCRIPTION&lt;/b&gt;&lt;br&gt;subscription_hash_key (PK)&lt;br&gt;load_date&lt;br&gt;record_source&lt;br&gt;subscription_id (Business Key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- LINKS -->
        <mxCell id="lnk_streaming" value="&lt;b&gt;LNK_STREAMING&lt;/b&gt;&lt;br&gt;customer_hash_key (FK)&lt;br&gt;content_hash_key (FK)&lt;br&gt;device_hash_key (FK)&lt;br&gt;stream_hash_key (FK)&lt;br&gt;load_date&lt;br&gt;record_source" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="420" y="70" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lnk_rental" value="&lt;b&gt;LNK_RENTAL&lt;/b&gt;&lt;br&gt;customer_hash_key (FK)&lt;br&gt;inventory_hash_key (FK)&lt;br&gt;rental_hash_key (FK)&lt;br&gt;load_date&lt;br&gt;record_source" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="420" y="270" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lnk_payment" value="&lt;b&gt;LNK_PAYMENT&lt;/b&gt;&lt;br&gt;customer_hash_key (FK)&lt;br&gt;rental_hash_key (FK)&lt;br&gt;subscription_hash_key (FK)&lt;br&gt;payment_hash_key (FK)&lt;br&gt;load_date&lt;br&gt;record_source" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="420" y="450" width="220" height="160" as="geometry" />
        </mxCell>

        <!-- SATELLITES -->
        <mxCell id="sat_customer" value="&lt;b&gt;SAT_CUSTOMER_DETAILS&lt;/b&gt;&lt;br&gt;customer_hash_key (FK)&lt;br&gt;load_date&lt;br&gt;load_end_date&lt;br&gt;record_source&lt;br&gt;hash_diff&lt;br&gt;first_name&lt;br&gt;last_name&lt;br&gt;email&lt;br&gt;phone&lt;br&gt;gender&lt;br&gt;status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="800" y="70" width="240" height="240" as="geometry" />
        </mxCell>
        <mxCell id="sat_content" value="&lt;b&gt;SAT_CONTENT_DETAILS&lt;/b&gt;&lt;br&gt;content_hash_key (FK)&lt;br&gt;load_date&lt;br&gt;load_end_date&lt;br&gt;record_source&lt;br&gt;hash_diff&lt;br&gt;title&lt;br&gt;content_type&lt;br&gt;duration_minutes&lt;br&gt;language&lt;br&gt;age_rating" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="800" y="350" width="240" height="220" as="geometry" />
        </mxCell>

        <!-- KEY PRINCIPLES NOTE -->
        <mxCell id="note_key" value="&lt;b&gt;KEY PRINCIPLES&lt;/b&gt;&lt;br&gt;- Hubs store unique business keys (immutable once loaded)&lt;br&gt;- Links store relationships between business entities&lt;br&gt;- Satellites store descriptive context with full history&lt;br&gt;- All records are insert-only (never updated or deleted)&lt;br&gt;- Hash keys enable parallel loading and source-system independence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=10" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1000" height="160" as="geometry" />
        </mxCell>

        <!-- EDGES: Hub -> Link connections. Each gets its own exit/entry point and, -->
        <!-- where source and target are not at similar heights, its own dedicated -->
        <!-- vertical lane in the 260-420 gap so no two lines run on top of each other. -->
        <mxCell id="edge_cust_stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#666666;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub_customer" target="lnk_streaming">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_cust_rental" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#666666;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub_customer" target="lnk_rental">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="285" y="178" />
              <mxPoint x="285" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_cust_payment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#666666;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub_customer" target="lnk_payment">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="142" />
              <mxPoint x="310" y="474" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_content_stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#666666;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub_content" target="lnk_streaming">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="335" y="248" />
              <mxPoint x="335" y="216" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_inventory_rental" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#666666;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub_inventory" target="lnk_rental">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="360" y="408" />
              <mxPoint x="360" y="382" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_subscription_payment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#666666;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub_subscription" target="lnk_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EDGE: Link -> Link (straight vertical, same column, no lane needed) -->
        <mxCell id="edge_rental_payment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lnk_rental" target="lnk_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EDGES: Hub -> Satellite (routed through the gaps between LINK boxes so the -->
        <!-- line does not cut through the LINKS column in between) -->
        <mxCell id="edge_cust_sat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub_customer" target="sat_customer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="250" />
              <mxPoint x="730" y="250" />
              <mxPoint x="730" y="118" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_content_sat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub_content" target="sat_content">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="430" />
              <mxPoint x="730" y="430" />
              <mxPoint x="730" y="438" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
