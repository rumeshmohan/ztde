# Copy this file to ".env" and fill in your own values. ".env" is git-ignored and must
# never be committed. docker-compose.yaml refuses to start if a required value is missing.
#
# If you reuse an existing Docker volume (postgres-db-volume), POSTGRES_PASSWORD must be
# the password that volume was first created with.

AIRFLOW_UID=50000

# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=<generate-a-fernet-key>

# Password for the Postgres container that holds Airflow's own metadata database.
# Keep it to letters and digits: it is used inside a connection URL.
POSTGRES_PASSWORD=<choose-a-password>

# Signs the API tokens between Airflow components. Any long random string.
AIRFLOW__API_AUTH__JWT_SECRET=<choose-a-long-random-string>

# Airflow web UI admin login (created by the airflow-init service)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=<choose-a-password>
